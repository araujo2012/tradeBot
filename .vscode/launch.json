{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Main (ts-node)",
      "runtimeExecutable": "ts-node",
      "args": ["${workspaceFolder}/main.ts"],
      "cwd": "${workspaceFolder}",
      "sourceMaps": true,
      "protocol": "inspector",
      "env": {
        "TS_NODE_TRANSPILE_ONLY": "true"
      }
    }
  ]
}
